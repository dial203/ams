# Settings for docker-compose.yml. Copy to `.env` (local Docker), or enter the same names and
# values as environment variables when deploying the stack in Portainer.

# Required: signs login tokens. 32+ random characters, e.g. `openssl rand -hex 32`.
AMS_SECRET_KEY=

# Database password, set when the database volume is first created. Letters and digits only
# (it is embedded in a connection URL), e.g. `openssl rand -hex 24`.
AMS_DB_PASSWORD=

# The address people open in a browser, used in invitation links. No trailing slash.
AMS_PUBLIC_URL=http://localhost:3001
# Host port for the web app (the API is served under /api on the same port).
AMS_WEB_PORT=3001

# First start, pick one or both:
# demo organization with 16 synthetic athletes (logins admin@example.com etc.)
AMS_SEED_DEMO=false
AMS_DEMO_PASSWORD=demo-password-change-me
# your own organization and its owner (the password applies only when the user is created)
AMS_ORG_NAME=
AMS_ORG_TIMEZONE=America/New_York
AMS_ADMIN_EMAIL=
AMS_ADMIN_PASSWORD=
AMS_ADMIN_NAME=

# Open Wearables (optional). Leave empty and the wearable screens say they are not set up.
OW_BASE_URL=
OW_API_KEY=
OW_PUBLIC_BASE_URL=
OW_APP_ID=
OW_APP_SECRET=
OW_WEBHOOK_SECRET=

# Expo push reminders for due questionnaires
EXPO_PUSH_ENABLED=false
