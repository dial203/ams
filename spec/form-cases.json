{
  "description": "Form evaluation and validation conformance cases. See docs/FORMS.md. Each case runs validate(schemas[case.schema], case.values) and compares: ok, errors (exact map), values (exact map), computed (exact map, numbers with relative tolerance 1e-9), and hidden (set of hidden field keys, order-insensitive).",
  "schemas": {
    "wellness": {
      "schema_version": 1,
      "sections": [
        {
          "key": "wellness",
          "title": "This morning",
          "fields": [
            {
              "key": "sleep_quality",
              "type": "scale",
              "label": "Sleep quality",
              "required": true,
              "min": 1,
              "max": 7
            },
            {
              "key": "fatigue",
              "type": "scale",
              "label": "Fatigue",
              "required": true,
              "min": 1,
              "max": 7
            },
            {
              "key": "stress",
              "type": "scale",
              "label": "Stress",
              "required": true,
              "min": 1,
              "max": 7
            },
            {
              "key": "soreness",
              "type": "scale",
              "label": "Muscle soreness",
              "required": true,
              "min": 1,
              "max": 7
            },
            {
              "key": "hooper_total",
              "type": "calculated",
              "label": "Hooper index",
              "expression": "sum(sleep_quality, fatigue, stress, soreness)",
              "decimals": 0
            },
            {
              "key": "sleep_hours",
              "type": "number",
              "label": "Hours slept",
              "min": 0,
              "max": 24,
              "unit": "h"
            }
          ]
        },
        {
          "key": "pain",
          "title": "Pain",
          "fields": [
            {
              "key": "has_pain",
              "type": "boolean",
              "label": "Any pain or injury?",
              "required": true
            },
            {
              "key": "pain_location",
              "type": "multiselect",
              "label": "Where?",
              "required": true,
              "visible_if": "has_pain == true",
              "options": [
                {
                  "value": "ankle",
                  "label": "Ankle"
                },
                {
                  "value": "knee",
                  "label": "Knee"
                },
                {
                  "value": "hip",
                  "label": "Hip"
                },
                {
                  "value": "back",
                  "label": "Back"
                }
              ],
              "max_selected": 2
            },
            {
              "key": "pain_score",
              "type": "scale",
              "label": "Pain (0-10)",
              "required": true,
              "min": 0,
              "max": 10,
              "visible_if": "has_pain"
            }
          ]
        }
      ]
    },
    "session": {
      "schema_version": 1,
      "sections": [
        {
          "key": "session",
          "title": "Session",
          "fields": [
            {
              "key": "session_type",
              "type": "select",
              "label": "Type",
              "required": true,
              "options": [
                {
                  "value": "field",
                  "label": "Field"
                },
                {
                  "value": "gym",
                  "label": "Gym"
                },
                {
                  "value": "rest",
                  "label": "Rest"
                }
              ]
            },
            {
              "key": "rpe",
              "type": "select",
              "label": "Session RPE (CR-10)",
              "required": true,
              "visible_if": "session_type != 'rest'",
              "options": [
                {
                  "value": 0,
                  "label": "Rest"
                },
                {
                  "value": 1,
                  "label": "Very, very easy"
                },
                {
                  "value": 2,
                  "label": "Easy"
                },
                {
                  "value": 3,
                  "label": "Moderate"
                },
                {
                  "value": 4,
                  "label": "Somewhat hard"
                },
                {
                  "value": 5,
                  "label": "Hard"
                },
                {
                  "value": 6,
                  "label": "6"
                },
                {
                  "value": 7,
                  "label": "Very hard"
                },
                {
                  "value": 8,
                  "label": "8"
                },
                {
                  "value": 9,
                  "label": "9"
                },
                {
                  "value": 10,
                  "label": "Maximal"
                }
              ]
            },
            {
              "key": "duration",
              "type": "duration",
              "label": "Duration",
              "required": true,
              "min": 0,
              "max": 600,
              "unit": "min",
              "visible_if": "session_type != 'rest'"
            },
            {
              "key": "srpe",
              "type": "calculated",
              "label": "Session load",
              "expression": "if(session_type == 'rest', 0, rpe * duration)",
              "unit": "AU"
            },
            {
              "key": "load_band",
              "type": "calculated",
              "label": "Band",
              "expression": "if(srpe >= 600, 'high', if(srpe >= 300, 'moderate', 'low'))"
            },
            {
              "key": "hard_reason",
              "type": "textarea",
              "label": "What made it hard?",
              "visible_if": "load_band == 'high'",
              "required": true,
              "max_length": 20
            },
            {
              "key": "duration_h",
              "type": "calculated",
              "label": "Duration (h)",
              "expression": "duration / 60",
              "decimals": 1,
              "unit": "h"
            },
            {
              "key": "duration_back",
              "type": "calculated",
              "label": "Minutes from rounded hours",
              "expression": "duration_h * 60"
            }
          ]
        }
      ]
    },
    "types": {
      "schema_version": 1,
      "sections": [
        {
          "key": "main",
          "title": "Main",
          "fields": [
            {
              "key": "note",
              "type": "info",
              "label": "Read me",
              "help": "Instructions"
            },
            {
              "key": "mass",
              "type": "number",
              "label": "Body mass",
              "min": 30,
              "max": 200,
              "unit": "kg",
              "decimals": 1
            },
            {
              "key": "rating",
              "type": "scale",
              "label": "Rating",
              "min": 0,
              "max": 10,
              "step": 0.5
            },
            {
              "key": "test_date",
              "type": "date",
              "label": "Date",
              "min": "2024-01-01",
              "max": "2030-12-31"
            },
            {
              "key": "start_time",
              "type": "time",
              "label": "Start"
            },
            {
              "key": "recorded_at",
              "type": "datetime",
              "label": "Recorded"
            },
            {
              "key": "comment",
              "type": "text",
              "label": "Comment",
              "max_length": 5
            },
            {
              "key": "tags",
              "type": "multiselect",
              "label": "Tags",
              "min_selected": 2,
              "options": [
                {
                  "value": "a",
                  "label": "A"
                },
                {
                  "value": "b",
                  "label": "B"
                },
                {
                  "value": "c",
                  "label": "C"
                }
              ]
            },
            {
              "key": "level",
              "type": "select",
              "label": "Level",
              "options": [
                {
                  "value": 1,
                  "label": "One"
                },
                {
                  "value": 2,
                  "label": "Two"
                }
              ]
            },
            {
              "key": "flag",
              "type": "boolean",
              "label": "Flag"
            }
          ]
        },
        {
          "key": "extra",
          "title": "Extra",
          "visible_if": "flag == true",
          "fields": [
            {
              "key": "extra_value",
              "type": "number",
              "label": "Extra",
              "required": true
            },
            {
              "key": "extra_double",
              "type": "calculated",
              "label": "Double",
              "expression": "extra_value * 2"
            }
          ]
        }
      ]
    }
  },
  "cases": [
