# AMS API reachable from the phone (use your computer's LAN IP, not localhost).
# `/api/v1` is appended when missing. Leave unset in development to use the Metro host's IP on port 8001.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8001
# EAS project id (needed for Expo push tokens). Optional.
EAS_PROJECT_ID=
