# AMS API configuration. Copy to .env for local runs (never commit .env).

# Postgres (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://ams:ams@localhost:5432/ams
# Celery broker
REDIS_URL=redis://localhost:6379/0

# HS256 key for access tokens and invitation links; at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AMS_SECRET_KEY=

# Comma-separated browser origins allowed by CORS (web app on 3001 in compose, Vite dev server on 5173)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# Used to build invitation links: {WEB_BASE_URL}/accept-invite?token=...
WEB_BASE_URL=http://localhost:3001

# Open Wearables (server-to-server). Leave OW_BASE_URL / OW_API_KEY empty to disable wearables (503).
OW_BASE_URL=http://localhost:8000
OW_API_KEY=
# Optional: the OW URL as seen by phones/browsers (SDK token responses, provider icons). Defaults to OW_BASE_URL.
OW_PUBLIC_BASE_URL=
# OW application credentials for minting SDK tokens (Apple Health / Health Connect sync). Empty -> 503.
OW_APP_ID=
OW_APP_SECRET=
# Signing secret of the OW webhook endpoint pointing at /api/v1/integrations/open-wearables/webhook (whsec_...)
OW_WEBHOOK_SECRET=
OW_TIMEOUT_SECONDS=10

# Where import uploads are kept for 24 h between preview and commit
AMS_UPLOAD_DIR=./uploads

# Expo push reminders for due forms (send_due_reminders runs every 15 min in beat)
EXPO_PUSH_ENABLED=false
# Minutes before a schedule's due_time that the reminder goes out
REMINDER_LEAD_MINUTES=60

# Token lifetimes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
INVITATION_DAYS=7

LOG_LEVEL=INFO
# Demo seed password (uv run python -m app.cli seed-demo)
AMS_DEMO_PASSWORD=demo-password-change-me
